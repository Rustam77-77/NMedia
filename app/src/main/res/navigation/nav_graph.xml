<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/feedFragment">
    <fragment
        android:id="@+id/feedFragment"
        android:name="ru.netology.fragment.FeedFragment"
        android:label="Лента"
        tools:layout="@layout/fragment_feed">

        <action
            android:id="@+id/action_feedFragment_to_newPostFragment"
            app:destination="@id/newPostFragment" />

        <action
            android:id="@+id/action_feedFragment_to_postDetailFragment"
            app:destination="@id/postDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/newPostFragment"
        android:name="ru.netology.fragment.NewPostFragment"
        android:label="Новый пост"
        tools:layout="@layout/fragment_new_post" />
    <fragment
        android:id="@+id/postDetailFragment"
        android:name="ru.netology.fragment.PostDetailFragment"
        android:label="Детали поста"
        tools:layout="@layout/fragment_post_detail">

        <argument
            android:name="postId"
            app:argType="long"
            android:defaultValue="0L" />

        <argument
            android:name="userId"
            app:argType="long"
            android:defaultValue="0L" />

        <argument
            android:name="action"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
</navigation>